# Server Configuration
PORT=3001
NODE_ENV=development

# Database
# NOTE: used by server/src/config/database.ts
DB_PATH=./data/governance.db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# xAI (Grok) Configuration
# Set XAI_API_KEY on the real server to enable Grok responses.
XAI_API_URL=https://api.x.ai/v1
XAI_API_KEY=
XAI_MODEL=grok-4-latest

# RAG / Chat tuning (optional)
RAG_MAX_TOKENS=1500
RAG_TEMPERATURE=0.1
RAG_CACHE_TTL_SEC=300
RAG_SYSTEM_PROMPT=

# CORS Configuration
# Frontend dev server (Vite) runs on :8080 in this repo
# 프로덕션 배포 시 도메인 추가
CORS_ORIGIN=http://localhost:8080,https://www.gngmeta.com,https://gngmeta.com

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./data/uploads
